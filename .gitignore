# Exercise media — fetched on first `docker compose up` (or via scripts/fetch-media.sh)
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Deployment/restore material is always kept outside the checkout.  Do not commit
# credentials, account databases, or any other backup copies here.
.pre-deploy-backup/
*.bak
*.bak-*
*.backup
*.premerge.*

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store

# Private programme source documents are mounted at runtime, never committed
Exercise_PDFs/
